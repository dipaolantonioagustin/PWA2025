@model _Tickets_Eventos

@{
}

<div class="container-fluid mb-5 pb-5 ">
    <div class="container-fluid py-0 my-0">
        <img src="~/img/Eventos/encabezado muestra permanente.jpg" style="width:100%;" alt="Alternate Text" />
    </div>


   <div class="container-fluid mt-1 mt-lg-3">
        <h2 class="fw-bold">Carrito Compras</h2>
       
        <div class="row">

            <div class="col-12 mt-lg-2 mt-1">
                <table class="table table-striped table-hover text-center align-middle fuente_tabla_CompraDetalle">
                    <thead class="table-warning fuente_Cabecera_PreView">
                        <tr>
                            <th>Evento</th>
                            <th>Fecha</th>
                            <th>Precio Ticket</th>
                            <th>Cantidad</th>
                            <th>Total Entradas</th>
                            <th>Botones</th>


                        </tr>
                       
                    <tbody>
                       
                               @if(Model.listaTickets != null){
                                   @foreach (var ticket in Model.listaTickets)
                                    {
                                        <tr>
                                           
                                            <td>@ticket.IdEventoNavigation.NombreEvento</td>
                                            <td>@ticket.IdEventoNavigation.FechaInicio.ToString("dd/MM/yyyy")</td>
                                            <td>@ticket.IdEventoNavigation.Valor</td>
                                            <td>@ticket.CantEntradas</td>
                                            <td></td>
                                            <td>  
                                               <form asp-controller="carrito"  method="post">
                                                   <input type="hidden" name="id" value="@ticket.TempId"></input>
                                                   <button type="submit" class="btn btn-danger" asp-controller="Carrito" asp-action="EliminarTicket">Eliminar</button>
                                               </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>Total:</td>
                                <td></td>
                                <td></td>
                        
                    </tbody>


                </table>


            </div>
            <div class="col-12 d-flex justify-content-end">

                <a type="button" class="btn btn-warning fw-bold ancho_botones_CompraDetalle" asp-area="" asp-controller="Carrito" asp-action="DetalleCompra">Continuar</a>

            </div>



        </div>
        
       
      


   </div>

       


</div>




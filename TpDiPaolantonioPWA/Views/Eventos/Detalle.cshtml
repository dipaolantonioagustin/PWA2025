@using System.Text.Json
@{
    
    var validador = TempData["Validador"] as bool?;
    
}

@model TpDiPaolantonioPWA.DAL.Evento

@if (validador != null && validador == true)
{
    <div class="alert alert-success">
        <strong>La Operacion se ah Realizado con Exito</strong>  ;


    </div>

}
else if (validador != null && validador == false)
{
    <div class="alert alert-danger">
        <strong>Ha Habido un Error al Cargar el Ticket</strong> ;


    </div>
}

<h2>@Model.Autor.Nombre @Model.Autor.Apellido</h2>

@Html.Partial("_Detalle", Model)

<form asp-controller="Carrito" asp-action="AgregarTicket" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="mb-2">
        <label for="cantidad">Cantidad de tickets:</label>
        <input type="number" name="cant" value="1" min="1" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Agregar al Carrito</button>
</form>


<div style="height: 100px;"></div>
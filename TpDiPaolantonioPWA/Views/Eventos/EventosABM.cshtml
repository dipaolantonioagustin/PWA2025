@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

    string AlertaMensaje = TempData["Mensaje"] as String;
    string Resultado = TempData["verificador"] as string;
}

    @if (AlertaMensaje != null && Resultado == "true")
    {
        <div class="alert alert-success">
            <strong>Éxito</strong> @AlertaMensaje;


        </div>

    }
    else if (AlertaMensaje != null && Resultado == "false")
    {
        <div class="alert alert-danger">
            <strong>Error</strong> @AlertaMensaje;


        </div>
    }

@model IEnumerable<Evento>

<div class="container-fluid mb-5 pb-5 ">
    <div class="container-fluid py-0 my-0">
        <img src="~/img/Eventos/encabezado muestra permanente.jpg" style="width:100%;" alt="Alternate Text" />
    </div>


    <div class="container-fluid mt-1 mt-lg-3">
        <h2 class="fw-bold">Eventos Vigentes</h2>

        <div class="row">

            <div class="col-12 mt-lg-2 mt-1">
                <table class="table table-striped table-hover text-center align-middle">
                    <thead class="table-warning fw-bold fuente_Cabecera_PreView">
                        <tr>
                            <th>Evento</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Precio Ticket</th>
                            <th>Tipo</th>
                            <th>Autor</th>
                            <th>Acciones</th>
                        </tr>

                    <tbody class="fuente_tabla_CompraDetalle">
                            @foreach (var e in Model)
                            {
                             <form asp-controller="Eventos" asp-action="Procesos">
                                <tr>
                                    <td>@e.NombreEvento</td>
                                    <td>@e.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@e.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td>@e.Valor</td>
                                    <td>@e.Tipo.Tipo</td>
                                    <td>@e.Autor.Nombre @e.Autor.Apellido</td>
                                    
                                     <td >
                                    <a class="btn btn-primary mt-2 mt-lg-0 mb-2 mb-lg-0 " asp-controller="Eventos" asp-action="modificar" asp-route-id_e="@e.Id">Modificar</a>
                                    <a class="btn btn-danger mt-2 mt-lg-0 mb-2 mb-lg-0 " asp-controller="Eventos" asp-action="Eliminar" asp-route-id_e="@e.Id">Eliminar</a>
                                     </td>  
                                </tr>
                            </form>
                            }
                       






                    </tbody>


                </table>


            </div>
            <div class="col-12 d-flex justify-content-center">

                <a type="button" class="btn btn-info fw-bold ancho_botones_CompraDetalle m-3" asp-area="" asp-controller="Eventos" asp-action="EventosAlta">Alta</a>
                
            </div>



        </div>





    </div>




</div>


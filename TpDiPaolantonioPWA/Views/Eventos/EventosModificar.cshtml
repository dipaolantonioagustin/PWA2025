@{
}
@using Microsoft.AspNetCore.Mvc.Rendering

@model _EventoVM

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <div class="card shadow rounded-2">

                <div class="card-body p-4">
                    <form asp-action="modificarEvento" asp-controller="Eventos" method="post" enctype="multipart/form-data">
                        
                        <input type="hidden" name="oEvento.Id" value=@Model.oEvento.Id />
                        
                        <div class="mb-3">
                            <label asp-for="oEvento.NombreEvento" class="form-label">Nombre del Evento</label>
                            <input asp-for="oEvento.NombreEvento" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="oEvento.Descripcion" class="form-label">Descripción</label>
                            <textarea asp-for="oEvento.Descripcion" class="form-control" rows="1" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="oEvento.DescripcionDetalle" class="form-label">Descripción Detalle</label>
                            <textarea asp-for="oEvento.DescripcionDetalle" class="form-control" rows="5" required></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="oEvento.FechaInicio" class="form-label">Fecha de Inicio</label>
                            <input asp-for="oEvento.FechaInicio" type="date" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="oEvento.FechaFin" class="form-label">Fecha de Fin</label>
                            <input asp-for="oEvento.FechaFin" type="date" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="oEvento.Sala" class="form-label">Sala</label>
                            <select asp-items="@Model.Sala.ToList()" asp-for="oEvento.SalaId" class="form-control" required>
                                <option>----Sala----</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="oEvento.Autor" class="form-label">Autor</label>
                            <select asp-items="@Model.Autor.ToList()" asp-for="oEvento.AutorId" class="form-control" required>
                                <option>----Autor----</option>
                            </select>

                        </div>

                        <div class="mb-3">
                            <label asp-for="@Model.fotoEvento" class="form-label">Foto Portada</label>
                            <input asp-for="@Model.fotoEvento" type="file" class="form-control" required />
                        </div>


                        <div class="mb-3">
                            <label asp-for="oEvento.Tipo" class="form-label">Tipo</label>
                            <select asp-items="@Model.Tipo.ToList()" asp-for="oEvento.TipoId" class="form-control" required>
                                <option>----Tipo----</option>


                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="oEvento.Valor" class="form-label">Valor ($)</label>
                            <input asp-for="oEvento.Valor" type="number" step="0.01" class="form-control" required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">Guardar</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
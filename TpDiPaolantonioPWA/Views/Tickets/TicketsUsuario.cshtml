


@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    TpDiPaolantonioPWA.Helpers.Pager pager = new TpDiPaolantonioPWA.Helpers.Pager();

    int NumeroPagina = 0;

    if(ViewBag.Pager != null)
    {

        pager = ViewBag.pager;
        NumeroPagina = ViewBag.pager.PaginaActual;


    }


}
@model _TicketsUsuario


<div class="container-fluid mb-5 pb-5 ">
<div class="container-fluid py-0 my-0">
    <img src="~/img/Eventos/encabezado muestra permanente.jpg" style="width:100%;" alt="Alternate Text" />
</div>


    <div class="container-fluid mt-1 mt-lg-3">
        <h2 class="fw-bold">Tickets Usuario</h2>
        <h3 class="fw-bold">@Model.usuario.nombre</h3>

        <div class="row">

            <div class="col-12 mt-lg-2 mt-1">
                <table class="table table-striped table-hover text-center align-middle fuente_tabla_CompraDetalle">
                    <thead class="table-warning fuente_Cabecera_PreView">
                        <tr>
   
                            <th>Evento</th>
                            <th>Fecha</th>
                            <th>Precio Ticket</th>
                            <th>Cantidad</th>
 
                        </tr>

                    <tbody>

                            @if (Model.listadoTickets != null)
                            {
                                @foreach (var ticket in Model.listadoTickets)
                                {
                                <tr>

                                    <td>@ticket.IdEventoNavigation.NombreEvento</td>
                                    <td>@ticket.IdEventoNavigation.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@ticket.IdEventoNavigation.Valor</td>
                                    <td>@ticket.CantEntradas</td>
                                    
                              
                                </tr>
                                }
                            }
             

                    </tbody>


                </table>


            </div>
            <div class="col-12 d-flex justify-content-end">

                <a type="button" class="btn btn-warning fw-bold ancho_botones_CompraDetalle" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>

            </div>



        </div>





    </div>

            <div class="container mt-3">
                @if (pager.TotalPaginas > 0)
                {
                    <ul class="pagination justify-content-center">
                        @for (var pge = pager.ComienzoPagina; pge <= pager.FinPagina; pge++)
                        {
                            <li class="page-item @(pge == pager.PaginaActual ? "active" : "")">
                                 <a class="page-link" asp-controller="Tickets" asp-action="TicketsUsuario" asp-route-pg="@pge">@pge</a>
                            </li>
                        }
                    

                    </ul>

                }




            </div>
        
    </div>



</div>